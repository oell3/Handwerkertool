

      <%- include('partials/header') %>
     <%- include('partials/navbar') %>


    <div class="container">
        <h1>Zahlungen</h1>

        <table class="table">
             <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">
            
            <thead>
                <th>Datum</th>
                <th>Rechnungsnummer</th>
                <th>Kunde</th>
                <th>Status</th>
            </thead>
            <tbody>
                <% zahlungen.forEach((item)=>{ %>
                <tr onclick="window.location='/zahlungen/<%= item.ID %>'" style="cursor: pointer;">
                     
                    <td><%= item.datum_formatiert %></td>
                    <td><%= rechnungen.find(r => r.ID === item.Rechnungs_ID)?.Rechnungsnummer %></td>
                    <td><%= kunden.find(k => k.ID === item.Kunden_ID)?.Name %></td>
                    <td><%= item.Status %></td>
                </tr>
                <%})%>
            </tbody>
        </table>
  
    </div>

</body>

<script src="/server.js"></script>

</html>