

     <%- include('partials/header') %>
     <%- include('partials/navbar') %>


    <div class="container">

        <h1>Katalog</h1>

        <table class="table">
            <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">

            <thead>
                <th>Artikelnummer</th>
                <th>Artikelname</th>
                <th>Preis</th>
            </thead>
            <tbody>
                <% katalog.forEach((item)=>{ %>
                    <tr onclick="window.location='/katalog/<%= item.ID %>'" style="cursor: pointer;">

                        <td>
                            <%= item.Artikelnummer %>
                        </td>
                        <td>
                            <%= item.Artikelname %>
                        </td>
                        <td>
                            <%= item.Preis %>
                        </td>

                    </tr>
                    <%})%>
            </tbody>
        </table>

    </div>
    </div>

</body>

<script src="/server.js"></script>

</html>