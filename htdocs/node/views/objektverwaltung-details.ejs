
      <%- include('partials/header') %>
     <%- include('partials/navbar') %>
      
    <div class="formular" id="formular" style="display: none;">
        <div class="container border rundung formular-size">
            <div class="container ">
                <h3>Neuen Artikel anlegen</h3>
                <form action="" method="get" class="newarticel">
                    <p>Händler
                        <input type="text" class="form-control" id="Händler">
                    </p>

                    <p>Artikelnummer
                        <input type="text" class="form-control" id="Artikelnummer">
                    </p>
                    <p>EAN
                        <input type="text" class="form-control" id="EAN">
                    </p>
                    <p>Art
                        <input type="text" class="form-control" id="Art">
                    </p>
                    <p>Bezeichnung
                        <input type="text" class="form-control" id="Bezeichnung">
                    </p>
                    <p>Einheit
                        <input type="text" class="form-control" id="Einheit">
                    </p>
                    <p>Einkaufspreis
                        <input type="text" class="form-control" id="Einkaufspreis">
                    </p>
                    <p>Aufschlag
                        <input type="text" class="form-control" id="Aufschlag">
                    </p>
                    <p>Verkaufspreis
                        <input type="text" class="form-control" id="Verkaufspreis">
                    </p>
                    <button type="submit" onclick=closeformular()>Artiken anlegen</button>
                </form>
            </div>


        </div>

    </div>

    <div class="container">

        <h2>Objektverwaltung Details</h2>
        <%= objekt.Adresse %>
            <%= objekt.PLZ %>
                <%= objekt.Stadt %>
    </div>
    <div class="container">
        <div class="container">
            <H2>Termine</H2>
            <table class="table">
                 <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">
                <thead>
                    <th>Datum</th>
                    <th>Status
                    <th>
                </thead>

                <% termine.forEach(function(item){ %>
                    <% if(item.Objekt_ID===objekt.ID){ %>
                        <tr onclick="window.location='/termine/<%= item.ID %>'" style="cursor: pointer;">
                            <td>
                                <%= item.datum_formatiert %>
                            </td>
                            <td>
                                <%= item.Status %>
                            </td>
                        </tr>
                        <% }}) %>
            </table>
        </div>

        <div class="container">
            <H2>Rechnungen</H2>
            <table class="table">
                <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">
                <thead>
                    <th>Datum</th>
                    <th>Status<th>
                </thead>

                <% rechnungen.forEach(function(item){ %>
                    <% if(item.Objekt_ID===objekt.ID){ %>
                        <tr onclick="window.location='/rechnungen/<%= item.ID %>'" style="cursor: pointer;">
                            <td>
                                <%= item.datum_formatiert %>
                            </td>
                            <td>
                                <%= item.Status %>
                            </td>
                        </tr>
                        <% }}) %>
            </table>
        </div>

        <div class="container">
            <H2>Angebote</H2>
            <table class="table">
                <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">
                <thead>
                    <th>Datum</th>
                    <th>Status<th>
                </thead>

                <% angebote.forEach(function(item){ %>
                    <% if(item.Objekt_ID===objekt.ID){ %>
                        <tr onclick="window.location='/angebote/<%= item.ID %>'" style="cursor: pointer;">
                            <td>
                                <%= item.datum_formatiert %>
                            </td>
                            <td>
                                <%= item.Status %>
                            </td>
                        </tr>
                        <% }}) %>
            </table>
        </div>
    </div>

    <div class="container">

        <div class="container">
            <H2>Projekte</H2>
            <table class="table">
                <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">
                <thead>
                    <th>Datum</th>
                    <th>Status<th>
                </thead>

                <% projekte.forEach(function(item){ %>
                    <% if(item.Objekt_ID===objekt.ID){ %>
                        <tr onclick="window.location='/angebote/<%= item.ID %>'" style="cursor: pointer;">
                            <td>
                                <%= item.datum_formatiert %>
                            </td>
                            <td>
                                <%= item.Status %>
                            </td>
                        </tr>
                        <% }}) %>
            </table>
        </div>

        <div class="container">
            <H2>Verträge</H2>
            <table class="table">
                <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">
                <thead>
                    <th>Datum</th>
                    <th>Art<th>
                </thead>

                <% verträge.forEach(function(item){ %>
                    <% if(item.Objekt_ID===objekt.ID){ %>
                        <tr onclick="window.location='/verträge/<%= item.ID %>'" style="cursor: pointer;">
                            <td>
                                <%= item.datum_formatiert %>
                            </td>
                            <td>
                                <%= item.Art %>
                            </td>
                        </tr>
                        <% }}) %>
            </table>
        </div>
    </div>
  
</body>
<script>
    document.getElementById('searchInput').addEventListener('keyup', function () {
        let filter = this.value.toLowerCase();
        let rows = document.querySelectorAll('tr th');

        rows.forEach(row => {
            let text = row.textContent.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    });
</script>
<script src="/customer.js"></script>

</html>