<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container">
    <h1>Routenplanung</h1>

    <label>Datum wählen:</label>
    <input type="date" id="dayPicker">

    <div id="info" style="margin-top:10px;"></div>

    <ul id="termineList"></ul>

    <div id="map" style="height:500px; margin-top:20px;"></div>
</div>

<%- include('partials/footer') %>

<script>
let map = L.map('map').setView([50.83, 12.92], 12);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

let routeLayer;
let markers = [];

// 🔹 heutiges Datum setzen
const today = new Date().toISOString().slice(0, 10);
const dateInput = document.getElementById('dayPicker');
dateInput.value = today;

// 🔹 Route laden
async function loadRoute(day) {
    const res = await fetch(`/api/termine?day=${day}`);
    const data = await res.json();



    // Reset
    document.getElementById('termineList').innerHTML = '';
    document.getElementById('info').innerHTML = '';

    // Marker entfernen
    markers.forEach(m => map.removeLayer(m));
    markers = [];

    if (!data.termine || data.termine.length === 0) {
        document.getElementById('info').innerHTML = 'Keine Termine gefunden';
        return;
    }

    // Infos anzeigen
    document.getElementById('info').textContent = 
    `📏 ${data.distanceKm} km | 🚗 ${data.durationMin} min | ⏱️ ${data.totalBuffer} min | 🧮 ${data.totalTime} min`;

// Marker + Liste
data.termine.forEach((t, i) => {

    // Datum in Uhrzeit umwandeln
    const arrivalTime = new Date(t.Datum);
    const hours = arrivalTime.getHours().toString().padStart(2, '0');
    const minutes = arrivalTime.getMinutes().toString().padStart(2, '0');
    const timeStr = `${hours}:${minutes}`;

    // Marker setzen
    const marker = L.marker([t.lat, t.lon]).addTo(map)
        .bindPopup(`${i === 0 ? "🏁 Start<br>" : ""}${t.name || ""}<br>${t.address || ""}<br>${i === 0 ? "" : `<br>🕒 ${timeStr}`}`);
    
    markers.push(marker);

    // In die Liste schreiben
    document.getElementById('termineList').innerHTML += `
        <li>${i === 0 ? "🏁 " : ""}${t.name || ""}  ${t.address || ""}  ${i === 0 ? "" : `<br>🕒 ${timeStr}`}</li>
    `;
});

    // Route zeichnen
    if (routeLayer) map.removeLayer(routeLayer);

    routeLayer = L.geoJSON(data.route).addTo(map);
    map.fitBounds(routeLayer.getBounds());
}

// 🔥 Auto Load (heute)
loadRoute(today);

// 🔹 Event
dateInput.addEventListener('change', (e) => {
    loadRoute(e.target.value);
});
</script>