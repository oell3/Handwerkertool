<%- include ('partials/header') %>


    <head>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" />
        <!-- Google Fonts -->
        <link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet">
        <link rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_back" />
        <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/angebotserstellung.css">
    
    </head>

   

    <div class="sidebar" style="overflow:hidden;">
        <%- include ('partials/navbar') %>
    </div>
    <div class="main-content page-shell" style="overflow: auto;">

        <div class="page-content">

        <!-- HEADER -->
        <div class="sticky-element">
            <div class="head">
                <span class="material-symbols-outlined" onclick="window.history.back()">arrow_back</span>
                <div class="title">
                    <h3>Angebotserstellung</h3>
                </div>
            </div>
            <button class="btn-primary" id="saveOffer">Angebot speichern</button>
        <button class="btn-primary" id="createOffer">Angebot erstellen</button>
        <</div>

        <!-- GRID -->
        <div class="grid">
            <!-- LEFT -->

        </div>

        <datalist id="Artikel">

        </datalist>
        <!-- Kunde -->
        <div class="card">
            <h3>Kunde & Projekt</h3>
            <div class="" style="display: flex; justify-content: space-around;">
                <div class="kup" >
                    <label>Kunde</label>

                    <select id="kundeSelect" placeholder="Kunde auswählen..."></select>
<label id="kundenanschrift"></label>
                </div>
               

                <div class="kup" >
                    <label>Ansprechpartner</label>

                    <select id="ansprechpartnerSelect" placeholder="Ansprechpartner auswählen..."></select>
 <label id="ansprechpartner"></label>
                </div>

               


                <div class="kup">
                    <label >Objekt</label>
                    <select id="objektSelect" placeholder="Objekt auswählen..."></select>
                    <label id="objektanschrift"></label>

                </div>
                 <div class="kup">
                    <label >Projekt</label>
                    <select id="projektSelect" placeholder="Projekt auswählen..."></select>
   <label id="projektanschrift"></label>
            

                </div>
                
         </div>

            
             
        </div>


        <!-- Angebot -->
        <div class="card">

            <div class="" style="display: flex;">
                <div>
                    <h3>Angebot</h3>

                    <select class="input" id="titleSelect" placeholder="Angebotsart auswählen..">
                        <option value="Indikatives Angebot">Indikatives Angebot</option>
                        <option value="Verbindliches Angebot">Verbindliches Angebot</option>
                        <option value="Preisindikation">Preisindikation</option>    
                    </select>

                </div>
                <div class="" style="margin-left: 50px;">
                    <h3>Angebotsdatum</h3>
                    <input class="input" id="angebotsdatum" type="date">
                </div>

            </div>



            <div class="">

                <h3>Anrede</h3>
                <input class="input" id="Anrede" style="width:250px;">

            </div>

        </div>

        <div class="card">
            <h3>Einleitungstext</h3>
            <select id="vorlageeinleitung" placeholder="Vorlage auswählen..."></select>
            <div id="einleitung"></div>
            <div class="vorlage">
                <input class="input" id="vorlagenameeinleitung" placeholder="Name der Vorlage vergeben..." />
                <button id="saveVorlageEinleitung"> Text als Vorlage speichern</button>
            </div>
        </div>

        <!-- Tabelle -->
        <div class="card">
            <h3>Leistungen</h3>
            <table>

                <tbody id="body"></tbody>
            </table>

            <br>

            <button id="addGroupBtn">+ Gruppe</button>
            <button id="addRowBtn">+ Position</button>
            <button id="clsMischBtn" style="display: none;">Mischposition schließen</button>
            <button id="clsGruppeBtn" style="display: none;">Gruppe schließen</button>
        </div>

        <div class="card">
            <h3>Schlusstext</h3>
            <select id="vorlageschluss" placeholder="Vorlage auswählen..."></select>
            <div id="schluss"></div>
            <div class="vorlage">
                <input class="input" id="vorlagenameschluss" placeholder="Name der Vorlage vergeben..." />
                <button id="saveVorlageSchluss"> Text als Vorlage speichern</button>
            </div>
        </div>
        <div class="card rsk">
            <!-- Rabatt -->
            <div class="">
                <h3>Rabatt & Skonto</h3>

                <input class="input" id="rabattProzent" placeholder="Rabatt %">
                <input class="input" id="rabattBetrag" placeholder="Rabatt €">

                <input class="input" id="skontoProzent" placeholder="Skonto %">
                <input class="input" id="skontoTage" placeholder="Tage">

                <div id="rabatttext"></div>
                <div id="skontotext"></div>

            </div>
            <div class="">
                <h3>Optionen</h3>
                <div id="lohnsteuerbox">
                <input type="checkbox" id="lohnsteuer" name="lohnsteuer"> <label for="">Umsatzsteuer für Lohnkosten
                    ausweisen</label> <br>
                    </div>
                <span id="lohnMwstText"></span>
                <input type="checkbox" id="langtext" name="langtext"> <label for="">Langetext ausweisen</label> <br>
            </div>

            <!-- RIGHT (KALKULATION) -->
            <div class="kalkulation">
                <div class="kal"></div>
                <div class="calc-main">💰 Übersicht</div>

                <div class="calc-row">
                    <span>Nettosumme</span>
                    <span id="ns">0€</span>
                </div>

                <div class="calc-row">
                    <span>Kosten</span>
                    <span id="kosten">0€</span>
                </div>

                <hr>

                <div class="calc-row">
                    <span>Material</span>
                    <span id="mk">0€</span>
                </div>

                <div class="calc-row">
                    <span>Lohn</span>
                    <span id="lk">0€</span>
                </div>

                <div class="calc-row">
                    <span>Sonstige</span>
                    <span id="sk">0€</span>
                </div>

                <hr>

                <div class="calc-row">
                    <span>Marge</span>
                    <span id="gm">0€</span>
                </div>

                <div class="calc-row tooltip">
                    <span>Marge %</span>
                    <span id="mp">0%</span>
                    <span class="tooltiptext">10–20% ist üblich</span>
                </div>


            </div>
        </div>

        </body>
        <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
               <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
        <script type="module" src="/js/main.js"></script>
        <script>
         document.addEventListener('DOMContentLoaded', function() {
            
        });
        </script>

        </html>