    /* =========================
       BASE
    ========================= */
    body {
      font-family: Arial, sans-serif;
      font-size: 12pt;
      color: #111;

    }

    /* =========================
       HEADER / FOOTER
    ========================= */

    .pdf-footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;

      background: white;
      z-index: 1000;
      text-align: center;
      font-size: 10px;
      color: #666;
      border-top: 1px solid #999;

    }


    /* =========================
       HEADER LAYOUTS
    ========================= */
  
    .header-content {
      justify-content: space-around;
      align-items: center;
      left: 0;
      right: 0;

    }


    .pdf-header.centered {
      text-align: center;
    }

    .logo.left {
      float: left;
    }

    .logo.right {
      float: right;
    }

    .logo.center {
      display: block;
      margin: 0 auto;
    }

    .meta {
      float: right;
    }

    /* =========================
       TEXT BLOCKS
    ========================= */

    .title {
      margin-top: 60px;
      font-size: 18px;
      font-weight: bold;
      margin-bottom: 15px;
      page-break-after: avoid;
      
    }

    .owner {
      font-size: 8pt;
      text-decoration: underline;
      margin-bottom: 10px;
    }
    



    .anschrift {
      margin-bottom: 15px;
      line-height: 1.5;
    }

    .anschreiben {
      margin-bottom: 10px;
    }

    .einleitung,
    .schluss {
      margin-bottom: 20px;
      page-break-inside: avoid;
    }

    /* =========================
       TABLE
    ========================= */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      page-break-inside: auto;
    }

    thead {
      page-break-after: avoid;
      display: table-header-group;
    }

    th {
      text-align: left;
      border-bottom: 2px solid #000;
      padding: 6px;
      font-size: 11px;
    }

    tr {
      page-break-inside: avoid;
    }

    td {
      font-size: 10pt;
      font-style: block;
      text-align: justify;
      vertical-align: top;
      padding: 6px;
      border-bottom: 1px solid #ddd;
    }
     .bezeichnung{
    width: 400px;
    word-break: break-all;
  }

    .group-row td {
      background: #f0f0f0;
      font-weight: bold;
      border-bottom: 2px solid #aaa;
    }

    .misch-parent td,
    .gruppen-parent td {
      background: #eef6ff;
      font-weight: bold;
    }

    .misch-child td,
    .gruppen-child td {
      padding-left: 25px;
      color: #333;
    }

    .remark {
      font-size: 10px;
      color: #666;
    }

    .label {
      font-size: 10px;
      font-style: italic;
    }

    .alt {
      color: #b45309;
    }

    .event {
      color: #b91c1c;
    }

    /* =========================
       SUMMARY
    ========================= */
    .summary {
      width: 300px;
      max-width: 100%;
      margin-left: auto;
      margin-right: 20px;
      margin-bottom: 20px;
      left: 0;
      right: 0;
      border: 1px solid #ddd;
      padding: 10px;
      page-break-inside: avoid;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 5px;
    }

    .summary-total {
      font-weight: bold;
      border-top: 2px solid #000;
      padding-top: 5px;
    }

    .group-total {
      width: 400px;
      max-width: 100%;
      margin-left: auto;
      margin-right: 20px;
      margin-bottom: 20px;
      padding: 10px;
      page-break-inside: avoid;
    }

    .group-summary-label,
.group-summary-total {
display: table-cell;
}

.group-summary-total {
text-align: right;
}

    .group-summary {
      margin-bottom: 10px;
      font-size: 12pt;
      width: 100%;
      align-items: right;
      justify-content: space-between;

   display: table;
width: 100%;
border-bottom: 1px dotted #000;

    }
  
  </style>

</head>

<body>

    <!-- ADRESSE -->
<div class="content">
    <% if (config.fields.showAddressBlock) { %>

      <div class="adresse">


        <% if (config.fields.showOwner) { %>
          <div class="owner">
            <%= config.company.ownerLine %>
          </div>
          <% } %>
            <% if (config.header.showMeta) { %>
              <div class="meta">
                <% if (config.fields.showSachbearbeiter) { %>
                  <div>Sachbearbeiter: <%= angebot.sachbearbeiter %>
                  </div>
                  <% } %>

                    <% if (config.fields.showObjekt) { %>
                      <div>Objekt: <%= angebot.objekt %>
                      </div>
                      <% } %>

                        <p>Angebot Nr: <%= angebot.Angebotsnummer %>
                        </p>
                        <p>Datum: <%= angebot.revisionsdatum %>
                        </p>
              </div>
              <% } %>


                <div class="anschrift">
                  <p>
                    <%= kunde.Name %>
                  </p>
                  <p>
                    <%= kunde.Adresse %>
                  </p>
                  <p>
                    <%= kunde.PLZ %>
                      <%= kunde.Stadt %>
                  </p>
                </div>


      </div>
      <% } %>

      

        <!-- TITEL -->

        <div class="title">
          <%= angebot.Title || "Unverbindliches Angebot" %>
        </div>

        <!-- ANSCHREIBEN -->

        <div class="anschreiben">
          <%= angebot.Anrede || "Sehr geehrte Damen und Herren," %>
        </div>

        <% if (config.fields.showEinleitung) { %>
          <div class="einleitung"><%- angebot.Einleitung || "" %></div>
          <% } %>

            <!-- OPTIONALE FELDER -->


            <h3>Leistungen</h3>

            <table>
              <thead>
                <tr>
                  <th>Nr</th>
                  <th>Bezeichnung</th>
                  <th>Menge</th>
                  <th>Einheit</th>
                  <th>EP(EUR)</th>
                  <th>GP(EUR)</th>
                </tr>
              </thead>


              <tbody>
                <% gruppen.forEach(g=> { %>

                  <tr class="group-row">
                    <td colspan="6" >
                      <%= g.nr %>
                      
                        <%= g.bezeichnung %>
                       
                    </td>
                  </tr>

                  <% g.positionen.forEach(p=> { %>
                    <% if (p.typ==="gruppe" ) return; %>

                      <tr>
                        <td class="nummer">
                          <%= p.nr %>
                        </td>

                        <td class="bezeichnung">
                          <%= p.bezeichnung %>

                            <% if (p.bemerkung) { %>
                              <div class="remark">
                                <%= p.bemerkung %>
                              </div>
                              <% } %>
                        </td>

                        <td>
                          <%= p.menge %>
                        </td>
                        <td>
                          <%= p.einheit %>
                        </td>
                        <td>
                          <%= Number(p.ep || 0).toFixed(2) %>
                        </td>
                        <td>
                          <%= Number(p.gp || 0).toFixed(2) %>
                        </td>
                      </tr>

                      <% }) %>

                        <% }) %>
              </tbody>


            </table>

            <!-- GROUP SUMMARIES -->
            <div class="group-total">

              <% gruppen.forEach(g=> { %>
                <% const groupSum=g.positionen.filter(p=> p.typ !== "gruppe").reduce((sum, pos) => sum + (pos.menge *
                  pos.ep), 0); %>
                  <div class="group-summary">
                    <div class="group-summary-label"><strong>
                        <%= g.nr %>. <%= g.bezeichnung %>:
                      </strong></div>
                    <div class="group-summary-total">
                      <%= Number(groupSum).toFixed(2) %> EUR
                    </div>
                  </div>
                  <% }) %>
            </div>
            <!-- SUMMARY -->

            <% if (config.summary.show) { %>

              <div class="summary">


                <% if (config.summary.showNetto) { %>
                  <div class="summary-row">
                    <div>Netto</div>
                    <div>
                      <%= netto.toFixed(2) %> EUR
                    </div>
                  </div>
                  <% } %>

                    <% if (config.summary.showMwst) { %>
                      <div class="summary-row">
                        <div>MwSt</div>
                        <div>
                          <%= mwst.toFixed(2) %> EUR
                        </div>
                      </div>
                      <% } %>

                        <% if (config.summary.showBrutto) { %>
                          <div class="summary-row summary-total">
                            <div>Brutto</div>
                            <div>
                              <%= brutto.toFixed(2) %> EUR
                            </div>
                          </div>
                          <% } %>


              </div>
              <% } %>

                <!-- SCHLUSS -->

                <% if (config.fields.showSchluss) { %>
                  <div class="schluss"><%- angebot.Schluss || "Mit freundlichen Grüßen" %></div>
                  <% } %>
  </div>
  <!-- FOOTER -->
 
</body>

</html>