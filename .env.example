# Diese Werte lokal in .env kopieren oder in Portainer als Stack-Variablen setzen.

# Host-Port, unter dem die Anwendung erreichbar ist
HOST_PORT=8089

# Port, auf dem Nginx innerhalb des Containers lauscht
CONTAINER_PORT=80

# Name des Docker-Containers
CONTAINER_NAME=crm

# Docker-Image
IMAGE_NAME=crm
IMAGE_TAG=latest

# Backend-Verbindung aus Sicht des Frontend-Containers
BACKEND_HOST=backend
BACKEND_PORT=3000
# Optionaler Pfad, z. B. /api. Leer lassen, wenn das Backend direkt am Hostnamen lauscht.
BACKEND_PATH=

# Optionaler vollständiger Override, z. B. http://backend:3000/api
# Wenn gesetzt, werden BACKEND_HOST, BACKEND_PORT und BACKEND_PATH ignoriert.
# BACKEND_URL=http://backend:3000

# Externes Docker-Netzwerk, in dem das Backend erreichbar ist
DOCKER_NETWORK=crm-network

# Container-Neustartverhalten
RESTART_POLICY=unless-stopped
