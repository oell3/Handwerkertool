
      <%- include('partials/header') %>
     <%- include('partials/navbar') %>
 


    <div class="container">
        <h2>Projekte</h2>
        <table class="table">
            <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">
            <thead>
                <tr>
                    <th>Termin</th>
                    <th>Adresse</th>
                    <th>Kunde</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                <% projekte.forEach(function(item){ %>
                    <tr onclick="window.location='/projekte/<%= item.ID %>'" style="cursor: pointer;">
                        
                       
                     
                                <td>
                                    <%= termine.find(t => t.Projekt_ID === item.ID)?.datum_formatiert %>
                                </td>
            
                        
                        <td>
                            <%= item.Adresse %>
                            <%= item.PLZ %>
                            <%= item.Stadt %>
                            
                        </td>
                         <td>
                                    <%= kunde.find(k => k.ID === item.Kunden_ID)?.Name %>
                                </td>
            
                        <td>
                            <%= item.Status %>
                        </td>
                        
                    </tr>
                    <%}) %>

            </tbody>
        </table>
    </div>

</body>
<script src="/server.js"></script>
</html>