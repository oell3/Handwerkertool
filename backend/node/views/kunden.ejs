

      <%- include('partials/header') %>
     <%- include('partials/navbar') %>


    <div class="formular" id="formular" style="display: none;">
        <div class="container border rundung formular-size">
            <div class="container ">
                <h3>Neuen Artikel anlegen</h3>
                <form action="" method="get" class="newarticel">
                    <p>Händler
                        <input type="text" class="form-control" id="Händler">
                    </p>

                    <p>Artikelnummer
                        <input type="text" class="form-control" id="Artikelnummer" required>
                    </p>
                    <p>EAN
                        <input type="text" class="form-control" id="EAN">
                    </p>
                    <p>Art
                        <input type="text" class="form-control" id="Art">
                    </p>
                    <p>Bezeichnung
                        <input type="text" class="form-control" id="Bezeichnung" required>
                    </p>
                    <p>Einheit
                        <input type="text" class="form-control" id="Einheit" required>
                    </p>
                    <p>Einkaufspreis
                        <input type="number" step="0.01" class="form-control" id="Einkaufspreis" required>
                    </p>
                    <p>Aufschlag
                        <input type="number" class="form-control" id="Aufschlag" required>
                    </p>
                    <p>Verkaufspreis
                        <input type="number" step="0.01" class="form-control" id="Verkaufspreis" required>
                    </p>
                    <button type="submit" onclick=closeformular()>Artiken anlegen</button>
                </form>
            </div>


        </div>

    </div>

    <div class="container">

        <h2>Kunden</h2>

        <div class="right">
            <button onclick=test()>Neuen Kunden anlegen</button>
        </div>

        <div class="container">

            <input class="form-control" type="text" id="searchInput" placeholder="Suchen...">
            <table class="table" id="myTable">
                <thead>
                    <tr>
                        <th>Typ</th>
                        <th>Kunde</a></th>
                        <th>Adresse</th>
                        <th>PLZ</th>
                        <th>Stadt</th>
                        <th>Projekte</th>
                    </tr>
                    </a>
                </thead>
                <tbody class="table-group-divider" id="testrow">
                    <% console.log(kunde); %>
                    <% kunde.forEach(function(item) { %>
                        <tr onclick="window.location='/kunden/<%= item.id %>'"
                                        style="cursor: pointer;">
                            <td>
                                <%= item.typ %>
                            </td>
                            <td>
                                <%= item.kunde %>
                            </td>
                            <td>
                                <%= item.adresse %>
                            </td>
                            <td>
                                <%= item.plz %>
                            </td>
                            <td>
                                <%= item.stadt %>
                            </td>
                            <td>

                            </td>

                        </tr>

                        <%})%>
                </tbody>
            </table>
        </div>
    </div>

</body>
<script>
    document.getElementById('searchInput').addEventListener('keyup', function () {
        let filter = this.value.toLowerCase();
        let rows = document.querySelectorAll('tr th');

        rows.forEach(row => {
            let text = row.textContent.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    });
</script>

<script src="/customer.js"></script>

</html>