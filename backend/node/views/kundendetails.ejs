<%- include('partials/header') %>
    <%- include('partials/navbar') %>
        <div class="container">

            <div class="row">
                <div class="row " style="flex-grow:2; flex:1;">


                    <div class="border">
                        <img src="" alt="">
                        <h1>
                            <%= kunde.Name %>
                        </h1>
                        <div>
                            <h2>
                                <%= kunde.Typ %>
                            </h2>
                        </div>
                        <div>
                            <h2>montaliche/quartal/halbjährlich/etc.</h2>
                        </div>
                        <div class="border-bottom">
                            <div class="column">
                                <span>
                                    <%= kunde.Anschrift %>
                                </span>
                                <span>
                                    <%= kunde.PLZ %>
                                        <%= kunde.Stadt %>
                                </span>
                                <span>Kundennummer: <%= kunde.ID %></span>
                            </div>
                        </div>

                        <div class="column">
                            <h5>Kundendaten</h5>
                            <span>Ansprechpartner</span>
                            <% const haupt=ansprechpartner.find(p=> p.Hauptansprechpartner == 1);
                                %>

                                <% if(haupt) { %>
                                    <p>
                                        Name: <%= haupt.Vorname %>
                                            <%= haupt.Nachname %><br>
                                                Mail: <%= haupt.Mail %><br>
                                                    Telefon: <%= haupt.Telefon %>
                                    </p>
                                    <% } %>
                        </div>

                        <div class="border-bottom">
                            <div class="column">
                                <span>IBAN: <%=kunde.IBAN %></span>
                                <span>Steueridentifikationsnummer: <%=kunde.Steueridentifikationsnummer %></span>
                                <span>Steuernummer:<%=kunde.Steuernummer%></span>
                            </div>
                        </div>

                        <div class="container" id="map"></div>
                        <div class="container" id="mapshow" style="height: 200px;">

                        </div>
                    </div>
                </div>





                <div class="" style="flex:2;">

                    <div class="tab row">
                        <button class="tablinks active" onclick="choosetable(event, 'Übersicht')">Übersicht</button>
                        <button class="tablinks" onclick="choosetable(event, 'Detail')">Detail</button>
                    </div>

                    <div id="Detail" class="container-fluid tabcontent">
                        <h3>Detail</h3>

                        <div class="container mt-5">
                            <h2>Ansprechpartner</h2>

                            <input class="form-control" id="searchInput" placeholder="Suchen..."
                                aria-label="Volltextsuche">
                            <table class="table" id="Ansprechpartner">
                                <thead>
                                    <tr>
                                        <th>Vorname</th>
                                        <th>Name</th>
                                        <th>Telefon</th>
                                        <th>Mobil</th>
                                        <th>E-Mail</th>
                                        <th>Fax</th>

                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    <% ansprechpartner.forEach(function(partner) { %>
                                        <tr onclick="window.location='/ansprechpartner/<%= partner.ID %>'"
                                            style="cursor: pointer;">
                                            <% if(partner.Hauptansprechpartner===1){ %>
                                                <td>
                                                    <%= partner.Vorname %>
                                                </td>
                                                <td>
                                                    <%= partner.Name %>
                                                </td>
                                                <td>
                                                    <%= partner.Telefon %>
                                                </td>
                                                <td>
                                                    <%= partner.Mobil %>
                                                </td>
                                                <td>
                                                    <%= partner.Mail %>
                                                </td>
                                                <td>
                                                    <%= partner.Fax %>
                                                </td>
                                        </tr>
                                        <% }}) %>
                                </tbody>
                            </table>
                        </div>

                        <div class="container border-bottom">
                            <h2>Objekte</h2>

                            <input class="form-control" id="searchInput" placeholder="Suchen..."
                                aria-label="Volltextsuche">
                            <table class="table" id="objekte">
                                <thead>
                                    <tr>
                                        <th>Objektadresse</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    <% objekte.forEach(function(objekt) { %>

                                        <tr onclick="window.location='/objekte/<%= objekt.ID %>'"
                                            style="cursor: pointer;">
                                            <td>
                                                <%= objekt.Adresse %>
                                                    <%= objekt.PLZ %>
                                                        <%= objekt.Stadt%>
                                            </td>
                                        </tr>

                                        <% }) %>
                                </tbody>
                            </table>
                        </div>





                        <div class="container mt-5">
                            <h2>Verträge</h2>

                            <input class="form-control" id="searchInput" placeholder="Suchen..."
                                aria-label="Volltextsuche">
                            <table class="table" id="Termine">
                                <thead>
                                    <tr>
                                        <th scope="Datum">Datum</th>
                                        <th scope="Art">Art</th>
                                        <th scope="Objekt">Objekt</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    <% verträge.forEach(function(vertrag) { %>

                                        <tr onclick="window.location='/vertrag/<%= vertrag.ID %>'"
                                            style="cursor: pointer;">

                                            <td>
                                                <%= vertrag.datum_formatiert %>
                                            </td>
                                            <td>
                                                <%= vertrag.Art %>
                                            </td>
                                            <td>
                                                <%= objekte.find(o=> o.ID === vertrag.Objekt_ID).Adresse; %>
                                                    <%= objekte.find(o=> o.ID === vertrag.Objekt_ID).PLZ; %>
                                                        <%= objekte.find(o=> o.ID === vertrag.Objekt_ID).Stadt; %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>

                    </div>

                    <div id="Übersicht" class="tabcontent">
                        <h3>Übersicht</h3>
                        <div class="row">
                            <div class="border rundung">
                                <h2>Umsatz (netto)</h2>
                                <span>120,00</span> €
                            </div>
                            <div class="border rundung">
                                <h2>offener Betrag (brutto)</h2>
                                <span>120,00</span> €
                            </div>
                        </div>

                        <div class="">
                            <div class="">
                                <h2>Projekte</h2>

                                <input class="form-control" id="searchInput" placeholder="Suchen..."
                                    aria-label="Volltextsuche">
                                <table class="table" id="projekte">
                                    <thead>
                                        <tr>
                                            <th scope="Projektnummer">Projektnummer</th>
                                            <th scope="Status">Status</th>
                                            <th scope="Ausführungsort">Ausführungsort</th>
                                        </tr>
                                    </thead>
                                    <tbody class="table-group-divider">
                                        <% projekte.forEach(function(projekt) { %>
                                            <tr onclick="window.location='/projekte/<%= projekt.ID %>'"
                                                style="cursor: pointer;">
                                                <td>
                                                    <%= projekt.ID %>
                                                </td>
                                                <td>
                                                    <%= projekt.Status%>
                                                </td>
                                                <td>
                                                    <%= objekte.find(o=> o.ID === projekt.Objekt_ID).Adresse; %>
                                                        <%= objekte.find(o=> o.ID === projekt.Objekt_ID).PLZ; %>
                                                            <%= objekte.find(o=> o.ID === projekt.Objekt_ID).Stadt; %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>



                        <h2>Termine</h2>

                        <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">
                        <table class="table" id="Termine">
                            <thead>
                                <tr>
                                    <th scope="Datum">Datum</th>
                                    <th scope="Status">Status</th>
                                    <th scope="Ausführungsort">Ausführungsort</th>
                                </tr>
                            </thead>
                            <tbody class="table-group-divider">
                                <% termine.forEach(function(termin) { %>
                                    <tr onclick="window.location='/termine/<%= termin.ID %>'" style="cursor: pointer;">
                                        <td>
                                            <%= termin.datum_formatiert %>
                                        </td>
                                        <td>
                                            <%= termin.Status %>
                                        </td>
                                        <td>
                                            <%= objekte.find(o=> o.ID === termin.Objekt_ID)?.Adresse; %>
                                                <%= objekte.find(o=> o.ID === termin.Objekt_ID)?.PLZ; %>
                                                    <%= objekte.find(o=> o.ID === termin.Objekt_ID)?.Stadt; %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>



                        <h2>Angebote</h2>

                        <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">
                        <table class="table" id="Termine">
                            <thead>
                                <tr>
                                    <th>Datum</th>
                                    <th>Status</th>
                                    <th>Angebotsnummer</th>
                                    <th>Angebotsname</th>
                                </tr>
                            </thead>
                            <tbody class="table-group-divider">
                                <% angebote.forEach(function(angebot) { %>
                                    <tr onclick="window.location='/angebote/<%= angebot.Angebotsnummer %>'"
                                        style="cursor:pointer">
                                        <td>
                                            <%= angebot.datum_formatiert %><br>
                                        </td>
                                        <td>
                                            <%=angebot.Status%>
                                        </td>
                                        <td>
                                            <%= angebot.Angebotsnummer%>
                                        </td>


                                        <td>
                                            <%= projekte.find(p=> p.ID === angebot.Projekt_ID)?.Adresse %>
                                        </td>


                                    </tr>

                    </div>

                    <% }) %>
                        </tbody>
                        </table>



                        <h2>Rechnungen</h2>

                        <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">
                        <table class="table" id="Termine">
                            <thead>
                                <tr>
                                    <th scope="Datum">Datum</th>
                                    <th scope="Rechnungsnummer">Rechnungsnummer</th>
                                    <th scope="Status">Status</th>
                                </tr>
                            </thead>
                            <tbody class="table-group-divider">
                                <% rechnungen.forEach(function(rechnung) { %>
                                    <tr onclick="window.location='/rechnungen/<%= rechnung.ID %>'"
                                        style="cursor: pointer;">

                                        <td>
                                            <%= rechnung.datum_formatiert %>
                                        </td>
                                        <td>
                                            <%= rechnung.Rechnungsnummer %>
                                        </td>
                                        <td>
                                            <%= rechnung.Status %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>


                        <div class="column">
                            <h2>Ausgaben</h2>
                            <div class=" border rundung">
                                <span>Es wurden noch keine Ausgaben erfasst!</span>
                            </div>
                        </div>



                        <h2>Dokumente</h2>
                        <div class="border rundung">
                            <span>Es wurden noch keine Dokumente hinterlegt!</span>
                        </div>


                </div>
            </div>
        </div>

        </body>
        <script>
            async function test() {
                try{
                let res = await fetch('http://127.0.0.1:8080/kunden/api/coords/<%= kunde.id %>');
                let [cords] = await res.json();
                let mapshow = L.map('mapshow').setView([cords.lat, cords.lon], 15);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(mapshow);

                L.marker([cords.lat, cords.lon]).addTo(mapshow);
                let routeLayer;

                routeLayer = L.geoJSON(data.route).addTo(mapshow);
                mapshow.fitBounds(routeLayer.getBounds());
                }catch(err){
                    console.log(err);
                }
            }

            test();

            document.getElementById('searchInput').addEventListener('keyup', function () {
                let filter = this.value.toLowerCase();
                let rows = document.querySelectorAll('tr th');

                rows.forEach(row => {
                    let text = row.textContent.toLowerCase();
                    row.style.display = text.includes(filter) ? '' : 'none';
                });
            });
        </script>
        <script src="/customer.js"></script>

        </html>