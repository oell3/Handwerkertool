

      <%- include('partials/header') %>
     <%- include('partials/navbar') %>

    <div class="formular" id="formular" style="display: none;">
        <div class="container border rundung formular-size">
            <div class="container ">
                <h3>Neuen Artikel anlegen</h3>
                <form action="" method="get" class="newarticel">
                    <p>Händler
                        <input type="text" class="form-control" id="Händler">
                    </p>

                    <p>Artikelnummer
                        <input type="text" class="form-control" id="Artikelnummer">
                    </p>
                    <p>EAN
                        <input type="text" class="form-control" id="EAN">
                    </p>
                    <p>Art
                        <input type="text" class="form-control" id="Art">
                    </p>
                    <p>Bezeichnung
                        <input type="text" class="form-control" id="Bezeichnung">
                    </p>
                    <p>Einheit
                        <input type="text" class="form-control" id="Einheit">
                    </p>
                    <p>Einkaufspreis
                        <input type="text" class="form-control" id="Einkaufspreis">
                    </p>
                    <p>Aufschlag
                        <input type="text" class="form-control" id="Aufschlag">
                    </p>
                    <p>Verkaufspreis
                        <input type="text" class="form-control" id="Verkaufspreis">
                    </p>
                    <button type="submit" onclick=closeformular()>Artiken anlegen</button>
                </form>
            </div>


        </div>

    </div>

    <div class="container pt-5">

        <h2>Objektverwaltung</h2>

        <div class="right">
            <button onclick=openformular()>Neues Objekt anlegen</button>
        </div>
        <div class="container">
            <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">
            <table class="table">
                 <input class="form-control" id="searchInput" placeholder="Suchen..." aria-label="Volltextsuche">
                <thead>
                    <tr>
                        <th>Adresse</th>
                        <th>Kunde</th>
                    </tr>
                </thead>
                <tbody class="table-group-divider">
                    <% objekte.forEach(function(objekt){ %>
                        <tr onclick="window.location='/objektverwaltung/<%= objekt.ID %>'" style="cursor: pointer;">
                            <td>
                                <%= objekt.Adresse %>
                                    <%= objekt.PLZ %>
                                        <%= objekt.Stadt %>
                            </td>
                            <td>
                                <%= kunde.find(k=> k.ID === objekt.Kunden_ID).Name %>
                            </td>
                        </tr>
                        <%}) %>

                </tbody>
            </table>
        </div>

    </div>
</body>
<script>
    document.getElementById('searchInput').addEventListener('keyup', function () {
        let filter = this.value.toLowerCase();
        let rows = document.querySelectorAll('tr th');

        rows.forEach(row => {
            let text = row.textContent.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    });
</script>
<script src="/customer.js"></script>

</html>